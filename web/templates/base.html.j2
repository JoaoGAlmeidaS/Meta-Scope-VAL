<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}MetaScope VAL{% endblock %}</title>
  <link rel="stylesheet" href="{{ base_url }}assets/style.css?v={{ build_version }}">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="{{ base_url }}">MetaScope<span>VAL</span></a>
    <nav>
      <a href="{{ base_url }}rankings.html">Rankings</a>
      <a href="{{ base_url }}meta.html">Meta</a>
      <a href="{{ base_url }}previsoes.html">Previsões</a>
      <a href="{{ base_url }}lineage/">Linhagem</a>
    </nav>
  </header>

  <main>{% block content %}{% endblock %}</main>

  <footer class="site-footer">
    <p>Build {{ build_version }} · dados via vlr.gg · modelo estatístico, não é conselho de aposta.</p>
  </footer>

  <script src="{{ base_url }}assets/echarts-theme.js?v={{ build_version }}"></script>
  <script src="{{ base_url }}assets/app.js?v={{ build_version }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
